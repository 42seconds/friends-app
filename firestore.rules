rules_version = '2';

// &FRIENDS Firestore security rules (draft for review).
//
// Admins are users whose users/{uid}.role is "admin". They can do
// everything the admin website and Staff mode need. Everyone else can
// only touch their own data, and only in the ways the app does.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // A code that can be used right now for this event (switched on, not
    // used up, not expired, and for this event if it's tied to one).
    function usableCode(code, eventId) {
      let path = /databases/$(database)/documents/promoCodes/$(code);
      let c = get(path).data;
      return code is string && code.size() > 0 && exists(path)
        && c.get('active', true) == true
        && (!('maxUses' in c) || c.get('uses', 0) < c.maxUses)
        && (!('expiresAtMs' in c) || c.expiresAtMs > request.time.toMillis())
        && (!('eventId' in c) || c.eventId == eventId);
    }

    // A usable code that gives a free (comp) ticket.
    function validComp(code, eventId) {
      return usableCode(code, eventId)
        && get(/databases/$(database)/documents/promoCodes/$(code)).data.get('type', 'percent') == 'comp';
    }

    // A booking with a code must count one use of it in the same write
    // (a batch), so a limited code can't be reused by skipping the count.
    function countsCodeUse(code, ticketId) {
      let path = /databases/$(database)/documents/promoCodes/$(code);
      return getAfter(path).data.get('uses', 0) == get(path).data.get('uses', 0) + 1
        && getAfter(path).data.get('lastTicketId', '') == ticketId;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---- Events: public when published, managed by admins ----------------
    match /events/{eventId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ---- User profiles --------------------------------------------------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // New accounts are always residents.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'resident';
      // People can edit their own profile but never their role.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
        || isAdmin();
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ---- Bookings ---------------------------------------------------------
    match /tickets/{ticketId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      // A booking starts as an unpaid hold owned by its creator, or as a
      // free confirmed booking when it uses a real, active comp code.
      // Any code on a booking must be usable for that event and have one
      // use counted in the same write.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (
          request.resource.data.get('promoCode', '') == ''
          || (
            usableCode(request.resource.data.promoCode, request.resource.data.eventId)
            && countsCodeUse(request.resource.data.promoCode, ticketId)
          )
        )
        && (
          !('status' in request.resource.data)
          || request.resource.data.status == 'pending_payment'
          || (
            request.resource.data.status == 'confirmed'
            && request.resource.data.totalPrice == 0
            && validComp(request.resource.data.get('promoCode', ''), request.resource.data.eventId)
          )
        );

      // Owners may: upload proof (moves it to "checking"), send it to a
      // friend, release it to the waitlist or ask for a refund. They can
      // never approve, check in, or change prices.
      allow update: if isAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (
          (
            onlyChanges(['proofOfPayment', 'proofUploadedAt', 'status'])
            // Website bookings have no status yet: treat them as unpaid.
            && resource.data.get('status', 'pending_payment') in ['pending_payment', 'rejected']
            && request.resource.data.status == 'pending_verification'
          )
          || onlyChanges(['transfer'])
          || onlyChanges(['releasedToWaitlist', 'releasedAt'])
          || onlyChanges(['refundRequested', 'refundRequestedAt'])
        )
      );

      allow delete: if isAdmin();
    }

    // ---- Waitlist: one entry per person per event ----------------------
    // Doc id is "{eventId}_{uid}". Signed-in users can read entries so
    // the app can work out their place in line.
    match /waitlist/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && entryId == request.resource.data.eventId + '_' + request.auth.uid
        && !('offerExpiresAt' in request.resource.data);
      // Owners can only toggle WhatsApp alerts; offers are set by admins.
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid && onlyChanges(['whatsappAlerts']));
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ---- Host enquiries and ratings: write-only for guests ---------------
    match /enquiries/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /ratings/{id} {
      allow create: if signedIn()
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow read, update, delete: if isAdmin();
    }

    // ---- Promo codes: looked up by exact code, managed by admins ---------
    match /promoCodes/{code} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
      // Counting one use, only together with a brand-new booking by the
      // same person that uses this code (written in the same batch).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'lastTicketId'])
        && request.resource.data.uses == resource.data.get('uses', 0) + 1
        && request.resource.data.lastTicketId is string
        && !exists(/databases/$(database)/documents/tickets/$(request.resource.data.lastTicketId))
        && getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.lastTicketId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/tickets/$(request.resource.data.lastTicketId)).data.get('promoCode', '') == code;
    }

    // ---- Gallery and site content (footer): public, admins edit ---------
    match /gallery/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- App config (e.g. config/app.minVersion) ---------------------------
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- One-time codes ----------------------------------------------------
    // Only the Cloud Functions (functions/index.js) read and write these;
    // nobody can read a code or change its attempt count from the app.
    match /otpCodes/{id} {
      allow read, write: if false;
    }
  }
}
